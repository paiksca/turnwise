{
  "name": "turnwise",
  "version": "0.2.0",
  "description": "Scores dialogue transcripts for bridging quality.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "turnwise": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --test dist/parse.test.js",
    "prepare": "npm run build",
    "calibrate": "node dist/calibrate.js",
    "smoke": "node dist/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Beyond Partisan (https://beyondpartisan.org)",
  "keywords": [
    "mcp",
    "depolarization",
    "conversation-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paiksca/turnwise.git"
  },
  "homepage": "https://github.com/paiksca/turnwise#readme",
  "bugs": {
    "url": "https://github.com/paiksca/turnwise/issues"
  }
}
